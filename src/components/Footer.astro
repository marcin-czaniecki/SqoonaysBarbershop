---
import { business, businessContact, legalPages } from '../data/business';
import { googleReviews } from '../data/reviews';
import BookingLink from './BookingLink.astro';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer"><div class="container">
  <div class="footer-top">
    <a href="/" class="wordmark" aria-label="Sqoonay’s Barbershop — strona główna">Sqoonay’s<span>BARBERSHOP · GDYNIA</span></a>
    <address class="footer-business">
      <strong>{business.legalName}</strong>
      <span>{businessContact.mailingAddress}</span>
      <span>NIP {business.taxId}</span>
      <a href={businessContact.email}>{business.contact.email}</a>
    </address>
    <a href="#start" class="text-link">Wróć na górę <Icon name="arrow_upward" class="arrow" /></a>
  </div>
  <div class="footer-bottom">
    <p>© {year} {business.name}</p>
    <nav aria-label="Informacje o serwisie">
      <a href={legalPages.privacy}>Polityka prywatności</a>
      <a href={legalPages.terms}>Regulamin serwisu</a>
    </nav>
    <nav aria-label="Profile salonu">
      <a href={business.links.booking}>Booksy <Icon name="north_east" size={14} /></a>
      <a href={business.links.instagram}>Instagram <Icon name="north_east" size={14} /></a>
      <a href={googleReviews.profileUrl}>Opinie w Google <Icon name="north_east" size={14} /></a>
    </nav>
  </div>
</div></footer>
<aside class="mobile-booking" aria-label="Szybka rezerwacja"><span>Twój kolejny termin</span><BookingLink variant="gold" /></aside>
