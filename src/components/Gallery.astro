---
import { gallery, photos } from '../data/media';
import { business } from '../data/business';
import PhotoFrame from './PhotoFrame.astro';
import Arrow from './Arrow.astro';
---
<section id="galeria" class="section gallery" aria-labelledby="gallery-title">
  <div class="container">
    <div class="section-heading"><div><p class="eyebrow">04 / GALERIA</p><h2 id="gallery-title">Miejsce na <span class="serif-emphasis">nasz klimat.</span></h2></div><a href={business.links.instagram} class="text-link">Zajrzyj na Instagram <Arrow diagonal /></a></div>
    <p class="gallery-note">Tu pojawią się zdjęcia salonu i naszych prac. Czekamy na autorskie materiały do publikacji.</p>
    <div class="gallery-grid">{gallery.map((item) => <figure><PhotoFrame label={item.label} number={item.number} photo={photos[item.key]} /><figcaption><span>{item.label}</span><span aria-hidden="true">/{item.number}</span></figcaption></figure>)}</div>
  </div>
</section>
