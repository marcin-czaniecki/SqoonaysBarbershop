---
import { business } from '../data/business';
import { social } from '../data/social';
import socialImage from '../data/social-image.json';
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = business.seo.title, description = business.seo.description, noindex = false } = Astro.props;
const site = Astro.site;
const canonical = site && !noindex ? new URL(Astro.url.pathname, site).href : undefined;
const isHome = Astro.url.pathname === '/';
const sharingTitle = isHome ? social.title : title;
const sharingDescription = isHome ? social.description : description;
const imageUrl = site ? new URL(socialImage.path, site).href : socialImage.path;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: business.name,
  legalName: business.legalName,
  telephone: business.contact.phone,
  email: business.contact.email,
  taxID: business.taxId,
  ...(site ? { url: site.href, '@id': new URL('#salon', site).href } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  sameAs: [business.links.booking, business.links.instagram],
  potentialAction: { '@type': 'ReserveAction', target: business.links.booking },
};
---
<!doctype html>
<html lang="pl" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-barlow" preload />
    <Font cssVariable="--font-manrope" preload />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1eee8" />
    <meta name="robots" content={site && !noindex ? 'index, follow' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    {site && <link rel="sitemap" href="/sitemap-index.xml" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={sharingTitle} />
    <meta property="og:description" content={sharingDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    {site && <meta property="og:image:secure_url" content={imageUrl} />}
    <meta property="og:image:type" content={socialImage.type} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content={social.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={sharingTitle} />
    <meta name="twitter:description" content={sharingDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={social.imageAlt} />
    {isHome && !noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
  </head>
  <body id="start"><a href="#tresc" class="skip-link">Przejdź do treści</a><slot /></body>
</html>
